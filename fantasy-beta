local _ind_font_sizes = { [1]=20, [1.25]=24, [1.5]=28, [1.75]=32, [2]=36 }

-- Pre-crear las 5 fuentes al cargar el script (fuera de Draw)
-- Evita crash por draw.CreateFont bajo carga dentro de un callback
do
    local _dpi_values = {1, 1.25, 1.5, 1.75, 2}
    for _, dpi in ipairs(_dpi_values) do
        local size = _ind_font_sizes[dpi] or 20
        pcall(function()
            _ind_fonts[dpi]       = { draw.CreateFont("Verdana", size, 600),  size }
            _ind_fonts_skeet[dpi] = { draw.CreateFont("Verdana", 12,   2000), 12   }
        end)
    end
end

-- Fuente "Skeet": Verdana 12 weight 2000 — igual que isabel
local _xhair_skeet_font = nil
pcall(function()
    _xhair_skeet_font = draw.CreateFont("Verdana", 12, 2000)
    _xhair_font_cache[12] = _xhair_skeet_font   -- pre-calentar el cache
end)

-- Pre-crear fuentes del rango del slider ind_xhair_gap (9-15)
-- Evita que _get_xhair_font llame draw.CreateFont dentro de Draw bajo carga (crash con TM/Trigger activo)
do
    for _sz = 9, 15 do
        if not _xhair_font_cache[_sz] then
            pcall(function()
                _xhair_font_cache[_sz] = draw.CreateFont("Verdana", _sz, 2000)
            end)
        end
    end
end

local function _ind_get_font(dpi)
    if _xhair_sel == 1 then
        return _ind_fonts_skeet[dpi] or { _xhair_skeet_font, 12 }
    end
    -- FIX #10: draw.CreateFont en Draw bajo carga puede crashear.
    -- Las fuentes se pre-crean al cargar el script (bloque do..end).
    -- Si por alguna razón no existe, usar la fuente más cercana en lugar de crear una nueva.
    if not _ind_fonts[dpi] then
        local closest_dpi, closest_dist = 1, 999
        for d, _ in pairs(_ind_fonts) do
            local dist = math.abs(d - dpi)
            if dist < closest_dist then closest_dpi = d; closest_dist = dist end
        end
        return _ind_fonts[closest_dpi] or { _xhair_skeet_font, 12 }
    end
    return _ind_fonts[dpi]
end


local _ind_skeet_pending = {}   -- buffer para modo Skeet (dibuja centrado al final)

local function renderer_indicator(r, g, b, a, ...)
    local text = table.concat({...})

    -- Modo Skeet: acumular para dibujar centrado en crosshair al final
    if _xhair_sel == 1 then
        table.insert(_ind_skeet_pending, { r=r, g=g, b=b, a=a, text=text })
        table.insert(_ind_frame_slots, true)
        return
    end

    local dpi  = _ind_dpi   -- cacheado en fv2_ind_reset, no releer gui cada call

    local fi   = _ind_get_font(dpi)
    local font, fs = fi[1], fi[2]
    if not font then return end
    draw.SetFont(font)

    local tw, th = draw.GetTextSize(text)
    local _, sh  = draw.GetScreenSize()

    local index  = #_ind_frame_slots
    local offset = (fs + math.floor(12 * dpi)) * index
    
    local x = math.floor(fs) + _ind_off_x_val
    local y = math.floor(sh - 350 * dpi) - offset + _ind_off_y_val

    if _ind_background then
        draw.SetTexture(_ind_background)
        draw.Color(0, 0, 0, 40)
        draw.FilledRect(
            math.floor(x + tw * 0.5 - tw * 0.8), y,
            math.floor(x + tw * 0.5),             y + fs + math.floor(4 * dpi))
        draw.FilledRect(
            math.floor(x + tw * 0.5 + tw * 0.8), y,
            math.floor(x + tw * 0.5),             y + fs + math.floor(4 * dpi))
        draw.SetTexture(nil)
    else
        draw.Color(0, 0, 0, 100)
        draw.FilledRect(x - 4, y - 2, x + tw + 4, y + fs + 2)
    end

    local text_y = math.floor(y + math.floor(2 * dpi) + (fs - th) * 0.5)
    local drawn  = false
    pcall(function()
        draw.Color(r, g, b, a)
        draw.TextShadow(x, text_y, text)
        drawn = true
    end)
    if not drawn then
        pcall(function()
            draw.Color(0, 0, 0, math.min(255, math.floor(a * 0.65)))
            draw.Text(x + 1, text_y + 1, text)
            draw.Color(r, g, b, a)
            draw.Text(x, text_y, text)
        end)
    end

    table.insert(_ind_frame_slots, true)
end

-- _ind_frame_slots se resetea al inicio de fv2_draw (ver abajo)
-- OPT: tabla valid fija (no recrear cada frame) + throttle cada 30 frames
local _ind_reset_valid = {1, 1.25, 1.5, 1.75, 2}
local _ind_reset_frame = 0
callbacks.Register("Draw", "fv2_ind_reset", function()
    _ind_reset_frame = _ind_reset_frame + 1
    if _ind_reset_frame < 30 then return end
    _ind_reset_frame = 0
    pcall(function()
        local raw = gui.GetValue("adv.dpi")
        if not raw then return end
        local dpi = (raw + 3) * 0.25
        local closest = 1
        for _, v in ipairs(_ind_reset_valid) do
            if math.abs(v - dpi) < math.abs(closest - dpi) then closest = v end
        end
        if closest ~= _ind_dpi then _ind_dpi = closest end
    end)
end)

