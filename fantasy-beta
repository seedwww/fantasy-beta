    -- ── Peek: dibujar círculo en start_pos (con estilos) ─────────────
    callbacks.Register("Draw","fv2_pk_draw",function()
        if not _pk_peeking or not _pk_start_pos then return end
        pcall(function()
            local sel = peek_style and peek_style:GetValue() or 0
            local t   = globals.RealTime()
            local r, g, b, a

            -- Color 1 = cuando registra/retorna; Color 2 = principal mientras peekea
            if _pk_returning then
                r, g, b, a = peek_circ_col:GetValue()
            else
                r, g, b, a = peek_ret_col:GetValue()
            end

            local px, py, pz = _pk_start_pos.x, _pk_start_pos.y, _pk_start_pos.z

            -- ── Helpers world-space ───────────────────────────────────
            local function wpt(ang, rad)
                return client.WorldToScreen(Vector3(
                    px + math.cos(ang) * rad,
                    py + math.sin(ang) * rad,
                    pz))
            end
            local function wring(rad, segs, skip, am)
                draw.Color(r, g, b, math.floor((a or 255) * (am or 1.0)))
                local step = (math.pi * 2) / segs
                local ppx, ppy = nil, nil
                for i = 0, segs do
                    if not skip or (i % 2 == 0) then
                        local sx2, sy2 = wpt(i * step, rad)
                        if sx2 and sy2 then
                            if ppx then draw.Line(ppx, ppy, sx2, sy2) end
                            ppx, ppy = sx2, sy2
                        else ppx, ppy = nil, nil end
                    else ppx, ppy = nil, nil end
                end
            end

            -- ── 0 Basic ───────────────────────────────────────────────
            if sel == 1 then
            do
                wring(15, 48, false, 1.0)
            end
            -- ── 1 Void ───────────────────────────────────────────────
            elseif sel == 0 then
            do
                wring(15, 48, false, 1.0)
                local p = math.sin(t*5)*2
                wring(15+p, 32, false, 0.45)
                wring(15-p, 32, false, 0.2)
            end
            -- ── 2 Radial ─────────────────────────────────────────────
            elseif sel == 2 then
            do
                -- anillos Prism rotando a distintas velocidades (fondo)
                local rings = {
                    {rad=10, spd= 2.1, segs=32},
                    {rad=15, spd=-1.4, segs=40},
                    {rad=20, spd= 0.8, segs=32},
                }
                for idx, rd in ipairs(rings) do
                    local rot2 = t * rd.spd
                    local ppxr, ppyr = nil, nil
                    for i = 0, rd.segs do
                        local frac = i/rd.segs
                        local ang  = rot2 + frac*math.pi*2
                        local alp  = 0.15 + 0.12*math.sin(frac*math.pi*2 + t*idx*0.4)
                        local sx2,sy2 = wpt(ang, rd.rad)
                        if sx2 and sy2 then
                            draw.Color(r,g,b, math.floor(a*alp))
                            if ppxr then draw.Line(ppxr,ppyr,sx2,sy2) end
                            ppxr,ppyr = sx2,sy2
                        else ppxr,ppyr = nil,nil end
                    end
                end
                -- dots radiales pulsantes (frente)
                local n   = 6
                local rot = t * 1.2
                for i = 0, n-1 do
                    local ang   = rot + (math.pi*2/n)*i
                    local pulse = 0.5 + 0.5*math.sin(t*2.5 + i*(math.pi*2/n))
                    local rad   = 12 + pulse*6
                    local trail = 12
                    for tr = 0, trail do
                        local frac = 1 - tr/trail
                        local glow = frac * frac
                        local a_tr = ang - tr*(math.pi/(n*trail))
                        local r_tr = math.max(8, rad - tr*0.4)
                        local ox,oy = wpt(a_tr, r_tr)
                        if ox and oy then
                            local sz = math.max(1, math.floor(frac*3.5))
                            draw.Color(r,g,b, math.floor(a*glow*0.35))
                            draw.FilledRect(ox-(sz+2), oy-(sz+2), ox+(sz+2), oy+(sz+2))
                            draw.Color(r,g,b, math.floor(a*glow))
                            draw.FilledRect(ox-sz, oy-sz, ox+sz, oy+sz)
                        end
                    end
                end
            end
            -- ── 3 Orbit ─────────────────────────────────────────────
            elseif sel == 3 then
            do
                wring(15, 48, false, 0.35)
                local layers = {
                    {spd=2.5, rad=15, n=3, trail=12, sz=3, alp=1.0 },
                    {spd=4.2, rad=22, n=2, trail=10, sz=2, alp=0.85},
                    {spd=1.6, rad=28, n=4, trail= 8, sz=2, alp=0.7 },
                    {spd=3.1, rad=19, n=5, trail= 6, sz=1, alp=0.5 },
                }
                for _, lyr in ipairs(layers) do
                    for dot = 0, lyr.n-1 do
                        local base = t*lyr.spd + (math.pi*2/lyr.n)*dot
                        for tr = 0, lyr.trail do
                            local frac = 1 - tr/lyr.trail
                            local glow = frac * frac
                            local ox, oy = wpt(base - tr*0.06, lyr.rad)
                            if ox and oy then
                                draw.Color(r,g,b, math.floor(a*lyr.alp*glow*0.35))
                                draw.FilledRect(ox-(lyr.sz+2), oy-(lyr.sz+2), ox+(lyr.sz+2), oy+(lyr.sz+2))
                                draw.Color(r,g,b, math.floor(a*lyr.alp*glow))
                                draw.FilledRect(ox-lyr.sz, oy-lyr.sz, ox+lyr.sz, oy+lyr.sz)
                            end
                        end
                    end
                end
            end
            -- ── 4 Pulse ──────────────────────────────────────────────
            elseif sel == 4 then
            do
                wring(15, 48, false, 0.15)
                local layers = {
                    {spd=3.0, rad=15, n=5, alp=1.0 },
                    {spd=1.8, rad=21, n=3, alp=0.7 },
                }
                for _, lyr in ipairs(layers) do
                    for dot = 0, lyr.n-1 do
                        local base  = t*lyr.spd + (math.pi*2/lyr.n)*dot
                        local pulse = 0.5 + 0.5*math.sin(t*3 + dot*1.2)
                        local sz    = math.max(1, math.floor(pulse*4))
                        local ox, oy = wpt(base, lyr.rad)
                        if ox and oy then
                            draw.Color(r,g,b, math.floor(a*lyr.alp*pulse*0.3))
                            draw.FilledRect(ox-(sz+3), oy-(sz+3), ox+(sz+3), oy+(sz+3))
                            draw.Color(r,g,b, math.floor(a*lyr.alp))
                            draw.FilledRect(ox-sz, oy-sz, ox+sz, oy+sz)
                        end
                    end
                end
            end
            -- ── 5 Wave ───────────────────────────────────────────────
            elseif sel == 5 then
            do
                wring(15, 48, false, 0.2)
                local n_dots = 4
                local spd    = 2.2
                local step   = math.pi*2 / 48
                for dot = 0, n_dots-1 do
                    local base = t*spd + (math.pi*2/n_dots)*dot
                    local trail = 20
                    for tr = 0, trail do
                        local frac = 1 - tr/trail
                        local glow = frac * frac
                        local ang  = base - tr*step
                        local ox,oy = wpt(ang, 15)
                        if ox and oy then
                            local sz = math.max(1, math.floor(frac*3))
                            draw.Color(r,g,b, math.floor(a*glow*0.3))
                            draw.FilledRect(ox-(sz+2), oy-(sz+2), ox+(sz+2), oy+(sz+2))
                            draw.Color(r,g,b, math.floor(a*glow))
                            draw.FilledRect(ox-sz, oy-sz, ox+sz, oy+sz)
                        end
                    end
                end
            end
            -- ── 6 Solar ──────────────────────────────────────────────
            elseif sel == 6 then
            do
                wring(15, 48, false, 0.2)
                local comets = {
                    {rad=15, spd=3.0, trail=20, sz=3},
                    {rad=22, spd=2.0, trail=16, sz=2},
                    {rad=28, spd=1.3, trail=12, sz=2},
                }
                for _, c in ipairs(comets) do
                    local base = t * c.spd
                    for tr = 0, c.trail do
                        local frac = 1 - tr/c.trail
                        local glow = frac * frac * frac
                        local ang  = base - tr * 0.07
                        local ox,oy = wpt(ang, c.rad)
                        if ox and oy then
                            local sz = (tr == 0) and c.sz or math.max(1, math.floor(frac*c.sz))
                            if tr == 0 then
                                draw.Color(r,g,b, math.floor(a*0.4))
                                draw.FilledRect(ox-(sz+3), oy-(sz+3), ox+(sz+3), oy+(sz+3))
                            end
                            draw.Color(r,g,b, math.floor(a*glow))
                            draw.FilledRect(ox-sz, oy-sz, ox+sz, oy+sz)
                        end
                    end
                end
            end
            -- ── 7 Prism ──────────────────────────────────────────────
            elseif sel == 7 then
            do
                local rings_d = {
                    {rad= 9, spd=2.8, segs=32},
                    {rad=13, spd=1.8, segs=40},
                    {rad=17, spd=0.9, segs=48},
                    {rad=21, spd=1.5, segs=40},
                    {rad=25, spd=2.2, segs=32},
                }
                for idx, rd in ipairs(rings_d) do
                    local rot = t * rd.spd
                    local ppx13, ppy13 = nil, nil
                    for i = 0, rd.segs do
                        local frac = i/rd.segs
                        local ang  = rot + frac*math.pi*2
                        local alp  = 0.25 + 0.4*math.sin(frac*math.pi*2 + t*idx*0.3)
                        local sx2,sy2 = wpt(ang, rd.rad)
                        if sx2 and sy2 then
                            draw.Color(r,g,b, math.floor(a*alp))
                            if ppx13 then draw.Line(ppx13,ppy13,sx2,sy2) end
                            ppx13,ppy13 = sx2,sy2
                        else ppx13,ppy13 = nil,nil end
                    end
                end
            end
            end
        end)
    end)
