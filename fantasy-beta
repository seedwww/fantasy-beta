                local is_gren2  = (wt2==9 or wt2==17 or wt2==15 or wt2==14 or wt2==16)
                local is_knife2 = (wt2 == 0)
                if ldc.ongren:GetValue()  and is_gren2  then return end
                if ldc.onknife:GetValue() and is_knife2 then return end
                if ldc.onkey:GetValue() then
                    local kb2 = ldc.keybox:GetValue()
                    if (tonumber(kb2) or 0) > 0 and input.IsButtonDown(kb2) then return end
                end
            end
            local st = sr.state()
            if st == 0 then return end
            local ang2 = cmd:GetViewAngles()
            if not ang2 then return end
            local offset = sr.angle:GetValue()
            if st == 1 then
                ang2.y = ang2.y + offset
            elseif st == 2 then
                ang2.y = ang2.y - offset
            end
            -- Clamp siempre para evitar crash
            while ang2.y >  180 do ang2.y = ang2.y - 360 end
            while ang2.y < -180 do ang2.y = ang2.y + 360 end
            cmd:SetViewAngles(ang2)
        end)
    end)

