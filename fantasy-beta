        -- FPS: avg sobre últimas 60 muestras, display actualizado cada 1s (RealTime)
        local _fps_samples   = {}
        local _fps_MAX       = 60
        local _fps_interval  = 1.0  -- segundos entre updates del display
        -- Expuestos al scope externo para poder resetearlos en round_start
        _G._fv2_fps_last_time  = 0
