                local _fwd_k = aa_fwd:GetValue()
                local _fwd_down = ((tonumber(_fwd_k) or 0) > 0 and input.IsButtonDown(_fwd_k))

                -- Shared state: actualizar siempre, independiente del modo Arrow activo
                do
                    local _typ_sh = (aa_ind_type and aa_ind_type:GetValue()) or 0
                    local _isback = _fwd_down or (test4_en:GetValue() and test4_cat:GetValue() == 1 and aa_yaw:GetValue() == 1)
                    local _csym   = _symbols[_typ_sh] or _symbols[1] or { r="\226\150\182", l="\226\151\128", d="\226\150\188" }
                    _aa_ind_shared.sym_r   = _csym.r
                    _aa_ind_shared.sym_l   = _csym.l
                    _aa_ind_shared.sym_d   = _csym.d
                    _aa_ind_shared.is_back = _isback and (_aa_manual_state == 0)
                end

                -- Arrow Rage draw (sel==1): encapsulado en pcall propio para no bloquear Arrow Legit
                pcall(function()
                -- Arrow Rage: el combobox puede devolver 0 o 1 segun runtime de Aimware
                -- Probamos el valor que NO usa Arrow Legit (sel==0 es Arrow Legit)
                local _no_cb_on = _G._fv2_aa_no_cb and _G._fv2_aa_no_cb:GetValue()
                local _no_sel   = _G._fv2_aa_no_sel and _G._fv2_aa_no_sel:GetValue()
                if not _no_cb_on then return end
                if _no_sel == 0 then return end  -- 0 = Arrow Legit, no dibujar aqui
                local lp = nil
                pcall(function() lp = entities.GetLocalPawn() end)
                if not lp or not lp:IsAlive() then return end

                if aa_ind_hidescope:GetValue() then
                    local _sc = false
                    pcall(function() _sc = lp:GetFieldBool("m_bIsScoped") == true end)
                    if _sc then return end
                end

                local sz   = aa_ind_size:GetValue()
                local gap  = aa_ind_gap :GetValue()
                if aa_ind_custom:GetValue() then
                    sz  = aa_ind_cust_size:GetValue()
                    gap = aa_ind_cust_gap :GetValue()
                end
                local typ  = aa_ind_type:GetValue()
                local r, g, b, a = aa_ind_col:GetValue()
                local sym  = _symbols[typ]

                local sw, sh = draw.GetScreenSize()
                local cx, cy = math.floor(sw / 2), math.floor(sh / 2)

                local _aa_f = _get_aa_font(sz)
                if not _aa_f then return end
                draw.SetFont(_aa_f)

                local is_naturally_back = _fwd_down or (test4_en:GetValue() and test4_cat:GetValue() == 1 and aa_yaw:GetValue() == 1)

                -- Si style es Off (typ==0): no dibujar
                if typ == 0 then return end

                -- Arrow dibuja si AA Rage (toggle del script) esta activo
                local aa_is_on = test4_en:GetValue() and test4_cat:GetValue() == 1
                if not aa_is_on then return end

                -- Direccion segun keybinds manuales
                -- El arrow sigue la VISTA del jugador (no la nuca del AA):
                -- state==1 = AA Left (nuca izq) → cara mira derecha → arrow right
                -- state==2 = AA Right (nuca der) → cara mira izquierda → arrow left
                -- show_down: AA Backward presionado  O  Yaw Type=Backwards en estado neutro
                local show_down  = is_naturally_back and (_aa_manual_state == 0)
                local show_right = (_aa_manual_state == 1) and not _fwd_down
                local show_left  = (_aa_manual_state == 2) and not _fwd_down
                if _fwd_down then show_down=true; show_right=false; show_left=false end

                if not show_right and not show_left and not show_down then return end

                -- ── Poly (4) = filled triangle | Hollow (5) = outline triangle ──
                if typ == 4 or typ == 5 then
                    local outline = (typ == 5)
                    local sa = math.min(255, math.floor(a * 0.6))

                    local function poly_right(ox, oy)
                        draw.Color(0, 0, 0, sa)
                        for col = 0, sz do
                            local h = math.floor(sz * (1 - col / sz) + 0.5)
                            local y1 = oy - math.floor(h / 2)
                            draw.FilledRect(ox+col+1, y1+1, ox+col+2, y1+h+1)
                        end
                        draw.Color(r, g, b, a)
                        for col = 0, sz do
                            local h = math.floor(sz * (1 - col / sz) + 0.5)
                            local y1 = oy - math.floor(h / 2)
                            if outline then
                                if col == 0 or col == sz then
                                    draw.FilledRect(ox+col, y1, ox+col+1, y1+h)
                                else
                                    draw.FilledRect(ox+col, y1,     ox+col+1, y1+1)
                                    draw.FilledRect(ox+col, y1+h-1, ox+col+1, y1+h)
                                end
                            else
                                draw.FilledRect(ox+col, y1, ox+col+1, y1+h)
                            end
                        end
                    end

                    local function poly_left(ox, oy)
                        draw.Color(0, 0, 0, sa)
                        for col = 0, sz do
                            local h = math.floor(sz * (1 - col / sz) + 0.5)
                            local y1 = oy - math.floor(h / 2)
                            draw.FilledRect(ox-col, y1+1, ox-col+1, y1+h+1)
                        end
                        draw.Color(r, g, b, a)
                        for col = 0, sz do
                            local h = math.floor(sz * (1 - col / sz) + 0.5)
                            local y1 = oy - math.floor(h / 2)
                            if outline then
                                if col == 0 or col == sz then
                                    draw.FilledRect(ox-col, y1, ox-col+1, y1+h)
                                else
                                    draw.FilledRect(ox-col, y1,     ox-col+1, y1+1)
                                    draw.FilledRect(ox-col, y1+h-1, ox-col+1, y1+h)
                                end
                            else
                                draw.FilledRect(ox-col, y1, ox-col+1, y1+h)
                            end
                        end
                    end

                    local function poly_down(ox, oy)
                        draw.Color(0, 0, 0, sa)
                        for row = 0, sz do
                            local w = math.floor(sz * (1 - row / sz) + 0.5)
                            local x1 = ox - math.floor(w / 2)
                            draw.FilledRect(x1+1, oy+row+1, x1+w+1, oy+row+2)
                        end
                        draw.Color(r, g, b, a)
                        for row = 0, sz do
                            local w = math.floor(sz * (1 - row / sz) + 0.5)
                            local x1 = ox - math.floor(w / 2)
                            if outline then
                                if row == 0 or row == sz then
                                    draw.FilledRect(x1, oy+row, x1+w, oy+row+1)
                                else
                                    draw.FilledRect(x1,     oy+row, x1+1,   oy+row+1)
                                    draw.FilledRect(x1+w-1, oy+row, x1+w,   oy+row+1)
                                end
                            else
                                draw.FilledRect(x1, oy+row, x1+w, oy+row+1)
                            end
                        end
                    end

                    if show_down then poly_down(cx, cy + gap)
                    elseif show_right then poly_right(cx + gap, cy)
                    elseif show_left then poly_left(cx - gap, cy)
                    end
                    return
                end

                -- ── Chevron (6) ── doble chevron con draw.Line ───────────
                if typ == 6 then
                    local hs   = math.floor(sz / 2)
                    local hs2  = math.floor(sz * 0.6)
                    local gap2 = math.floor(sz * 0.38)
                    local sa   = math.min(255, math.floor(a * 0.55))
                    local function chev_pair(x1,y1,x2,y2)
                        draw.Color(0,0,0,sa)
                        draw.Line(x1+1,y1+1,x2+1,y2+1)
                        draw.Line(x1+2,y1+1,x2+2,y2+1)
                        draw.Color(r,g,b,a)
                        draw.Line(x1,y1,x2,y2)
                        draw.Line(x1+1,y1,x2+1,y2)
                    end
                    if show_right then
                        local ox = cx + gap
                        chev_pair(ox,        cy-hs, ox+hs2, cy)
                        chev_pair(ox,        cy+hs, ox+hs2, cy)
                        chev_pair(ox+gap2,   cy-hs, ox+gap2+hs2, cy)
                        chev_pair(ox+gap2,   cy+hs, ox+gap2+hs2, cy)
                    elseif show_left then
                        local ox = cx - gap
                        chev_pair(ox,        cy-hs, ox-hs2, cy)
                        chev_pair(ox,        cy+hs, ox-hs2, cy)
                        chev_pair(ox-gap2,   cy-hs, ox-gap2-hs2, cy)
                        chev_pair(ox-gap2,   cy+hs, ox-gap2-hs2, cy)
                    elseif show_down then
                        local oy = cy + gap
                        chev_pair(cx-hs, oy,       cx, oy+hs2)
                        chev_pair(cx+hs, oy,       cx, oy+hs2)
                        chev_pair(cx-hs, oy+gap2,  cx, oy+gap2+hs2)
                        chev_pair(cx+hs, oy+gap2,  cx, oy+gap2+hs2)
                    end
                    return
                end

                -- ── Arrow (7) ── open outline arrow, 3px stroke ──────────
                if typ == 7 then
                    local hs = math.floor(sz * 0.55)
                    local sa = math.min(255, math.floor(a * 0.45))
                    local function arrow_line(x1,y1,x2,y2)
                        draw.Color(0,0,0,sa)
                        draw.Line(x1+1,y1+1,x2+1,y2+1)
                        draw.Line(x1+2,y1+1,x2+2,y2+1)
                        draw.Line(x1+3,y1+1,x2+3,y2+1)
                        draw.Color(r,g,b,a)
                        draw.Line(x1,  y1,  x2,  y2)
                        draw.Line(x1+1,y1,  x2+1,y2)
                        draw.Line(x1+2,y1,  x2+2,y2)
                    end
                    if show_right then
                        local ox = cx + gap
                        arrow_line(ox, cy-hs, ox+hs, cy)
                        arrow_line(ox, cy+hs, ox+hs, cy)
                    elseif show_left then
                        local ox = cx - gap
                        arrow_line(ox, cy-hs, ox-hs, cy)
                        arrow_line(ox, cy+hs, ox-hs, cy)
                    elseif show_down then
                        local oy = cy + gap
                        arrow_line(cx-hs, oy, cx, oy+hs)
                        arrow_line(cx+hs, oy, cx, oy+hs)
                    end
                    return
                end

                -- Estilos unicode (Triangle, Modern, Dashes)
                if not sym then return end
                local sym_r = sym.r
                local sym_l = sym.l
                local sym_d = sym.d or "▼"
                local tw_r, th_r = draw.GetTextSize(sym_r)
                local tw_l       = draw.GetTextSize(sym_l)
                local tw_d       = draw.GetTextSize(sym_d)
                local ty = cy - math.floor(th_r / 2)

                if show_right then
                    draw.Color(0, 0, 0, math.min(255, math.floor(a * 0.6)))
                    draw.Text(cx + gap + 1, ty + 1, sym_r)
                    draw.Color(r, g, b, a)
                    draw.Text(cx + gap, ty, sym_r)
                elseif show_left then
                    draw.Color(0, 0, 0, math.min(255, math.floor(a * 0.6)))
                    draw.Text(cx - gap - tw_l + 1, ty + 1, sym_l)
                    draw.Color(r, g, b, a)
                    draw.Text(cx - gap - tw_l, ty, sym_l)
                elseif show_down then
                    local dx = cx - math.floor(tw_d / 2)
                    local dy = cy + gap
                    draw.Color(0, 0, 0, math.min(255, math.floor(a * 0.6)))
                    draw.Text(dx + 1, dy + 1, sym_d)
                    draw.Color(r, g, b, a)
                    draw.Text(dx, dy, sym_d)
                end
                end) -- cierre pcall Arrow Rage

                -- ── Arrow Legit draw (sel==0) ─────────────────────────────
                pcall(function()
                    local no_on  = _G._fv2_aa_no_cb  and _G._fv2_aa_no_cb:GetValue()
                    local sel    = _G._fv2_aa_no_sel  and _G._fv2_aa_no_sel:GetValue()
                    if not (no_on and sel == 0) then return end
                    local t8 = _G._fv2_aa_t8; if not t8 then return end

                    local typ = t8.dir:GetValue()
                    if typ == 0 then return end

                    local lp8 = nil
                    pcall(function() lp8 = entities.GetLocalPawn() end)
                    if not lp8 or not lp8:IsAlive() then return end

                    -- Hide on Scope compartido
                    if aa_ind_hidescope:GetValue() then
                        local _sc = false
                        pcall(function() _sc = lp8:GetFieldBool("m_bIsScoped") == true end)
                        if _sc then return end
                    end

                    -- Dirección: keybinds de AA Legit (_sraa_state)
                    local sr = _G._fv2_sraa; if not sr then return end
                    local show_right, show_left = false, false
                    local one_mode = sr.one:GetValue()
                    if one_mode then
                        show_right = (sr.state() == 1)
                        show_left  = (sr.state() == 2)
                    else
                        local lk = sr.left:GetValue()
                        local rk = sr.right:GetValue()
                        local lk_down = (tonumber(lk) or 0) > 0 and input.IsButtonDown(lk)
                        local rk_down = (tonumber(rk) or 0) > 0 and input.IsButtonDown(rk)
                        local st = sr.state()
                        if     lk_down then show_right = true
                        elseif rk_down then show_left  = true
                        else show_right = (st == 1); show_left = (st == 2)
                        end
                    end
                    if not show_right and not show_left then return end

                    local r2, g2, b2, a2 = t8.col:GetValue()
                    local sz2  = t8.size:GetValue()
                    local gap2 = t8.gap :GetValue()
                    local sw2, sh2 = draw.GetScreenSize()
                    local cx2 = math.floor(sw2 / 2)
                    local cy2 = math.floor(sh2 / 2)
                    local _dir_syms = {
                        [1] = { r = "▶", l = "◀" },
                        [2] = { r = "⮚", l = "⮘" },
                        [3] = { r = "‒", l = "‒" },
                    }
                    local sym2 = _dir_syms[typ]; if not sym2 then return end
                    local font2 = _get_aa_font(sz2); if not font2 then return end
                    draw.SetFont(font2)
                    local sa2 = math.min(255, math.floor(a2 * 0.6))
                    if show_right then
                        local tw, th = draw.GetTextSize(sym2.l)
                        local ty2 = cy2 - math.floor(th / 2)
                        draw.Color(0, 0, 0, sa2)
                        draw.Text(cx2 - gap2 - tw + 1, ty2 + 1, sym2.l)
                        draw.Color(r2, g2, b2, a2)
                        draw.Text(cx2 - gap2 - tw, ty2, sym2.l)
                    elseif show_left then
                        local tw, th = draw.GetTextSize(sym2.r)
                        local ty2 = cy2 - math.floor(th / 2)
                        draw.Color(0, 0, 0, sa2)
                        draw.Text(cx2 + gap2 + 1, ty2 + 1, sym2.r)
                        draw.Color(r2, g2, b2, a2)
                        draw.Text(cx2 + gap2, ty2, sym2.r)
                    end
                end)
        end)  -- cierre pcall exterior fv2_aa_draw
        end)  -- cierre callbacks.Register fv2_aa_draw
    end

    callbacks.Register("Draw", "fv2_rb_wepsel", function()
        pcall(function()
            local feat_on = rb_dmg_feature:GetValue()
            local sel     = rb_wep_combo:GetValue() + 1
            local ovr     = feat_on and rb_override_en[sel] and rb_override_en[sel]:GetValue()
            local lc      = _rb_wepsel_last
            if lc.feat == feat_on and lc.sel == sel and lc.ovr == ovr then return end
            lc.feat = feat_on; lc.sel = sel; lc.ovr = ovr
            for i = 1, #rb_wep_groups do
                local is_sel = feat_on and (i == sel)
                rb_mdmg[i]       :SetInvisible(not is_sel)
                rb_override_en[i]:SetInvisible(not is_sel)
                rb_override_val[i]:SetInvisible(not (is_sel and rb_override_en[i]:GetValue()))
            end
        end)
    end)

    callbacks.Register("Draw", "fv2_rb_draw", function()
        pcall(function()
            local rage_on  = rb_rage_enable:GetValue()
            -- legit_on: Trigger OR Autofire activos
            local legit_on = kb_trigger:GetValue() or kb_autofire:GetValue()

            -- Resolución de conflicto: el último en activarse apaga al otro
            if rage_on and legit_on then
                local rage_rising = rage_on and not _last_rage_state
                if rage_rising then
                    -- Rage recién activado → apagar legit
                    kb_trigger:SetValue(false)
                    kb_autofire:SetValue(false)
                    legit_on = false
                else
                    -- Legit recién activado (o ambos simultáneos) → apagar rage
                    rb_rage_enable:SetValue(false)
                    rage_on = false
                end
            end


            -- --------------------------------------------------------
            -- Ragebot master: solo sincronizar al cambiar estado
            -- FIX: aplicar cada frame pisaba el toggle nativo de Aimware
            -- impidiendo clickearlo manualmente
            -- --------------------------------------------------------
            if rage_on ~= _last_rage_state or legit_on ~= _last_legit_state then
                _last_rage_state  = rage_on
                _last_legit_state = legit_on

                pcall(function() gui.SetValue("rbot.master",       rage_on) end)
                pcall(function() gui.SetValue("rbot.enabled",      rage_on) end)
                pcall(function() gui.SetValue("rbot.enable",       rage_on) end)
                pcall(function() gui.SetValue("rbot.main.enable",  rage_on) end)
                pcall(function() gui.SetValue("rbot.main.enabled", rage_on) end)
                pcall(function() gui.SetValue("rbot.main.master",  rage_on) end)

                if rage_on and legit_on then
                    -- conflicto ya resuelto arriba, solo apagar lbot
                    sv("lbot.master",  false)
                    sv("lbot.enable",  false)
                    sv("lbot.enabled", false)
                elseif legit_on then
                    sv("rbot.master",        false)
                    sv("rbot.enabled",       false)
                    sv("rbot.enable",        false)
                    sv("rbot.main.enable",   false)
                    sv("rbot.main.enabled",  false)
                    sv("rbot.main.master",   false)
                end
            end

            -- Autowall Rage (independiente de rage_on para que funcione siempre)
            do
                local rb_aw_val = rb_autowall_enable:GetValue()
                if rb_aw_val ~= _last_rb_autowall then
                    _last_rb_autowall = rb_aw_val
                    for _, grp in ipairs(rb_wep_groups) do
                        sv("rbot.weapon."..grp..".autowall",           rb_aw_val)
                        sv("rbot.hitscan.accuracy."..grp..".autowall", rb_aw_val)
                        sv("rbot.accuracy."..grp..".autowall",         rb_aw_val)
                    end
                    sv("rbot.autowall", rb_aw_val)
                end
            end

            -- Force Body: solo body.priority=1, todo lo demás apagado (igual que frog pero completo)
            if rb_forcebody:GetValue() then
                local grp = "shared"
                pcall(function()
                    local raw = tostring(gui.GetValue("rbot.accuracy") or ""):gsub('"',''):lower()
                    local wmap = {["pistol"]="pistol",["heavy pistol"]="hpistol",
                                  ["scout"]="scout",["auto sniper"]="asniper",
                                  ["sniper"]="sniper",["smg"]="smg",["rifle"]="rifle",
                                  ["shotgun"]="shotgun",["lmg"]="lmg",["zeus"]="zeus"}
                    grp = wmap[raw] or "shared"
                end)
                -- Guardar TODOS los campos la primera vez o si cambió el arma
                if _rb_fb_orig == nil or _rb_fb_orig_grp ~= grp then
                    local b = "rbot.hitbox."..grp.."."
                    local o = {}
                    pcall(function() o.hp  = gui.GetValue(b.."head.priority")  end)
                    pcall(function() o.he  = gui.GetValue(b.."head.exposed")   end)
                    pcall(function() o.hc  = gui.GetValue(b.."head.center")    end)
                    pcall(function() o.bp  = gui.GetValue(b.."body.priority")  end)
                    pcall(function() o.bl  = gui.GetValue(b.."body.lethal")    end)
                    pcall(function() o.be  = gui.GetValue(b.."body.exposed")   end)
                    pcall(function() o.bc  = gui.GetValue(b.."body.center")    end)
                    pcall(function() o.le  = gui.GetValue(b.."limbs.exposed")  end)
                    pcall(function() o.lc  = gui.GetValue(b.."limbs.center")   end)
                    _rb_fb_orig     = o
                    _rb_fb_orig_grp = grp
                end
                -- Aplicar: solo body priority, todo lo demás OFF
                local base = "rbot.hitbox."..grp.."."
                pcall(function() gui.SetValue(base.."head.priority",  0) end)
                pcall(function() gui.SetValue(base.."head.exposed",   0) end)
                pcall(function() gui.SetValue(base.."head.center",    0) end)
                pcall(function() gui.SetValue(base.."body.priority",  1) end)
                pcall(function() gui.SetValue(base.."body.lethal",    0) end)
                pcall(function() gui.SetValue(base.."body.exposed",   0) end)
                pcall(function() gui.SetValue(base.."body.center",    0) end)
                pcall(function() gui.SetValue(base.."limbs.exposed",  0) end)
                pcall(function() gui.SetValue(base.."limbs.center",   0) end)
            elseif _rb_fb_orig ~= nil then
                -- Restaurar TODOS los campos al desactivar
                local grp = _rb_fb_orig_grp or "shared"
                local base = "rbot.hitbox."..grp.."."
                local o = _rb_fb_orig
                pcall(function() gui.SetValue(base.."head.priority",  o.hp) end)
                pcall(function() gui.SetValue(base.."head.exposed",   o.he) end)
                pcall(function() gui.SetValue(base.."head.center",    o.hc) end)
                pcall(function() gui.SetValue(base.."body.priority",  o.bp) end)
                pcall(function() gui.SetValue(base.."body.lethal",    o.bl) end)
                pcall(function() gui.SetValue(base.."body.exposed",   o.be) end)
                pcall(function() gui.SetValue(base.."body.center",    o.bc) end)
                pcall(function() gui.SetValue(base.."limbs.exposed",  o.le) end)
                pcall(function() gui.SetValue(base.."limbs.center",   o.lc) end)
                _rb_fb_orig     = nil
                _rb_fb_orig_grp = nil
            end

            if rb_dynfov_enable:GetValue() then
                local mn = rb_dynfov_min:GetValue()
                local mx = rb_dynfov_max:GetValue()
                if mn > mx then mn, mx = mx, mn end
                local factor   = rb_dynfov_factor:GetValue()
                local tick_min = math.max(1, math.floor(30 - factor * 0.09))
                local tick_max = math.max(tick_min + 1, math.floor(60 - factor * 0.18))
                if globals.TickCount() >= rb_fov_state.next_tick then
                    -- math.random(a,b) entero: llega exactamente al maximo
                    -- multiplicado x10 para preservar 1 decimal (ej: 55..90 → 5.5..9.0)
                    local mn10 = math.floor(mn * 10 + 0.5)
                    local mx10 = math.floor(mx * 10 + 0.5)
                    rb_fov_state.current   = math.random(mn10, mx10) / 10
