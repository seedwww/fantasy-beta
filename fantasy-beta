    -- FFI: unlock nFlags del ConVar "name"
    xpcall(function()
        local ffi2 = ffi
        if not pcall(ffi2.sizeof, "struct IEngineCvar_CT") then
            ffi2.cdef [[
                typedef struct CConVar_CT {
                    const char* szName;
                    struct CConVar_CT* pNext;
                    char pad_01[0x10];
                    const char* szDescription;
                    uint32_t nType;
                    uint32_t nRegistered;
                    uint32_t nFlags;
                    uint32_t m_unk3;
                    uint32_t m_nCallbacks;
                    uint32_t m_unk4;
                    union {
                        bool        Bool;
                        int         Int;
                        float       Float;
                        const char* String;
                    } Value;
                } CConVar_CT;
                typedef struct CUtlLinkedListElement_CT {
                    struct CConVar_CT* element;
                    uint16_t iPrevious;
                    uint16_t iNext;
                } CUtlLinkedListElement_CT;
                typedef struct IEngineCvar_CT {
                    char pad_01[0x40];
                    uint64_t unk_pad;
                    struct CUtlLinkedListElement_CT* pMemory;
                    uint16_t iHead;
                    uint16_t iTail;
                    uint16_t iFirstFree;
                    uint16_t nElementCount;
                    uint16_t nAllocated;
                } IEngineCvar_CT;
                void* GetProcAddress(uintptr_t, const char*);
                typedef void*(*fnCreateInterface_CT)(const char*, void*);
            ]]
        end
        local tier0 = mem.GetModuleBase("tier0.dll")
        local ci = ffi2.cast("fnCreateInterface_CT", ffi2.C.GetProcAddress(tier0, "CreateInterface"))
        local ICvar = ffi2.cast("struct IEngineCvar_CT*", ci("VEngineCvar007", nil))
        if ICvar == nil then return end
        local data = ICvar.pMemory
        for i = 0, ICvar.nAllocated - 1 do
            local node = data[i]
            local cvar = node.element
            if cvar ~= nil and cvar.szName ~= nil then
                if ffi2.string(cvar.szName) == "name" then
                    cvar.nFlags = 33408
                    _G.__ct_ffi_cvar = cvar
                    _G.__ct_ffi_ok   = true
                    break
                end
            end
        end
    end, function(msg) print("[clantag] FFI error: " .. tostring(msg)) end)

