        local _aa_font_cache    = { sz = -1, font = nil }
        local function _get_aa_font(sz)
            if sz == _aa_font_cache.sz then return _aa_font_cache.font end
            local best, bd = _aa_fonts[8], 999
            for s, f in pairs(_aa_fonts) do
                if math.abs(s - sz) < bd then best = f; bd = math.abs(s - sz) end
            end
            _aa_font_cache.sz   = sz
