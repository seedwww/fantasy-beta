    -- Manual AA en PreMove (igual que frog): corre ANTES del autostrafe nativo
    -- del cheat, evitando la desincronización yaw/movimiento que causaba stutter.
    callbacks.Register("PreMove", "fv2_aa_premove", function(cmd)
        pcall(function()
            if not cmd then return end
            local lp_pawn = entities.GetLocalPawn()
            if not lp_pawn or not lp_pawn:IsAlive() then return end

            local angle = cmd:GetViewAngles()
            if not angle then return end

            local ext = _G._fv2_aa_ext

            local aa_on         = test4_en:GetValue() and test4_cat:GetValue() == 1
            local manual_active = (_aa_manual_state ~= 0)
            local fwd_key_pm    = aa_fwd:GetValue()
            local fwd_active_pm = ((tonumber(fwd_key_pm) or 0) > 0 and input.IsButtonDown(fwd_key_pm))
            -- FIX: fwd_active tambien activa el PreMove AA
            if not aa_on and not manual_active and not fwd_active_pm then return end

            -- Skip on ladder or grenade
            local movetype = 0
            pcall(function()
                movetype = lp_pawn:GetPropInt("m_nActualMoveType")
                         or lp_pawn:GetFieldInt("m_nActualMoveType") or 0
            end)
            if movetype == 9 then return end

            local weaponType = -1
            pcall(function() weaponType = lp_pawn:GetWeaponType() end)

            -- Disable Conditions
            local dc = _G._fv2_aa_dc
            if dc then
                local is_grenade = (weaponType == 9 or weaponType == 17 or weaponType == 15
                                    or weaponType == 14 or weaponType == 16)
                local is_knife   = (weaponType == 0)
                if dc.ongren:GetValue()  and is_grenade then return end
                if dc.onknife:GetValue() and is_knife   then return end
                if dc.onkey:GetValue() then
                    local kb = dc.keybox:GetValue()
                    if (tonumber(kb) or 0) > 0 and input.IsButtonDown(kb) then return end
                end
            end

            -- No AA on Shot removido del GUI (desactivado)

            local tick   = globals.TickCount()
            local base_y = angle.y
            local ym     = aa_yaw:GetValue()
            local pm     = aa_pitch:GetValue()
            local preset = aa_yaw_preset:GetValue()

            -- At Targets rota la base 180° para que los offsets apunten hacia el enemigo.
            -- Backwards (ym==1) en estado neutro suma otros 180° sobre base_y RAW (no sobre base_y ya rotado).
            -- Se guarda base_y_raw antes del ajuste de At Targets para que Backwards
            -- funcione correctamente con o sin At Targets activado.
            local base_y_raw = base_y
            if aa_dir_tgt:GetValue() then
                base_y = base_y + 180
            end

            -- Helper: aplica el preset seleccionado al ángulo.
            -- fallback_deg = offset de dirección (89=right, -89=left, 180=fwd).
            -- Índices: 0=Disabled, 1=Spinbot, 2=Jitter, 3=Random, 4=Moonwalk
            local function apply_dir_preset(p, fallback_deg)
                local dir_base = base_y + fallback_deg  -- base apuntando a la dirección del bind
                if p == 1 and ext then
                    angle.y = dir_base + (tick * ext.spin_speed:GetValue()) % 360
                elseif p == 2 and ext then
                    local jt = ext.jitter_tick:GetValue()
                    local jr = ext.jitter_range:GetValue()
                    angle.y = dir_base + ((tick % jt >= jt / 2) and jr or -jr)
                elseif p == 3 then
                    angle.y = dir_base + math.random(-180, 180)
                elseif p == 4 then
                    -- Moonwalk: cara a la dirección del bind (right mira right, left mira left)
                    angle.y = dir_base
                else
                    -- Disabled (0): dirección pura del bind
                    angle.y = dir_base
                end
            end

            -- FWD override: usa el preset asignado a Forward
            if fwd_active_pm then
                apply_dir_preset(0, 180)
            -- Manual Left (bind izquierda): usa el preset configurado para "Left" en el grupo
            elseif _aa_manual_state == 1 then
                apply_dir_preset(aa_yaw_preset_left:GetValue(), -89)
            -- Manual Right (bind derecha): usa el preset configurado para "Right" en el grupo
            elseif _aa_manual_state == 2 then
                apply_dir_preset(aa_yaw_preset_right:GetValue(), 89)
            else
                -- Estado neutro: si Yaw Type = Backwards, los presets parten de base_y_raw+180.
                -- Se usa base_y_raw (sin el +180 de At Targets) para que Backwards siempre
                -- apunte hacia atrás del jugador, independientemente de At Targets.
                local nb = (ym == 1) and (base_y_raw + 180) or base_y
                if preset == 1 and ext then
                    angle.y = nb + (tick * ext.spin_speed:GetValue()) % 360
                elseif preset == 2 and ext then
                    local jt = ext.jitter_tick:GetValue()
                    local jr = ext.jitter_range:GetValue()
                    angle.y = nb + ((tick % jt >= jt / 2) and jr or -jr)
                elseif preset == 3 then
                    angle.y = nb + math.random(-180, 180)
                elseif preset == 4 then
                    -- Moonwalk: usar nb como base (ya tiene +180 si backwards)
                    angle.y = nb
                elseif ym == 1 then
                    -- Disabled + Backwards: anclar ángulo opuesto al view del jugador
                    angle.y = base_y_raw + 180
                end
            end

            -- Pitch
            if pm == 1 then      angle.x = 89
            elseif pm == 2 then  angle.x = -89
            elseif pm == 3 then  angle.x = 0
            elseif pm == 4 then  angle.x = (tick % 4 < 2) and 89 or -89
            end

            -- Clamp SIEMPRE: ángulo fuera de rango causa crash nativo en CS2 (no lo atrapa pcall)
            while angle.y >  180 do angle.y = angle.y - 360 end
            while angle.y < -180 do angle.y = angle.y + 360 end
            -- Anti-Invalid: clamp de pitch siempre activo
            if angle.x >   89 then angle.x =  89 end
            if angle.x <  -89 then angle.x = -89 end

            cmd:SetViewAngles(angle)
        end)

        -- Semi-Rage AA: corre solo cuando lbot (legit) está activo
        pcall(function()
            if not cmd then return end
            local sr = _G._fv2_sraa
            if not sr or not (test4_en:GetValue() and test4_cat:GetValue() == 0) then return end
            local lp2 = entities.GetLocalPawn()
