    -- Custom Scope Lines
    local function interpolate(s, e, p)
        return math.floor(s + ((e - s) * p))
    end
    local function drawGradientLine(x, y, dx, dy, length, thickness, r1, g1, b1, a1, r2, g2, b2, a2, mode)
        if length < 1 then return end   -- cubre length=0 y fracciones (<1 → steps=0 → div/0)
        -- Cap a 60 pasos: 4 lineas × 60 = 240 draw calls/frame (antes 480)
        local steps    = math.min(math.floor(length), 60)
        local stepSize = length / steps  -- seguro: steps >= 1 porque length >= 1
        for i = 0, steps - 1 do
            local p = i / steps
            if mode == 0 then p = 1 - p end
            local r = interpolate(r1, r2, p)
            local g = interpolate(g1, g2, p)
            local b = interpolate(b1, b2, p)
            local a = interpolate(a1, a2, p)
            local curX  = x + dx * i * stepSize
            local curY  = y + dy * i * stepSize
            local nextX = x + dx * (i + 1) * stepSize
            local nextY = y + dy * (i + 1) * stepSize
            draw.Color(r, g, b, a)
            if thickness <= 1 then
                draw.Line(math.floor(curX), math.floor(curY), math.floor(nextX), math.floor(nextY))
            else
                local off = math.floor(thickness / 2)
                if dx ~= 0 then
                    draw.FilledRect(math.min(math.floor(curX), math.floor(nextX)), math.floor(curY) - off,
                                    math.max(math.floor(curX), math.floor(nextX)), math.floor(curY) - off + thickness)
                else
                    draw.FilledRect(math.floor(curX) - off, math.min(math.floor(curY), math.floor(nextY)),
                                    math.floor(curX) - off + thickness, math.max(math.floor(curY), math.floor(nextY)))
                end
            end
        end
    end
    
