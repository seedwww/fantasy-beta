        callbacks.Register("Draw", "fv2_wm_cache", function()
            _wm_active = wm_master:GetValue()
            if not _wm_active then return end

            -- Acumular muestra cada frame (igual que la imagen)
            pcall(function()
                local ft = globals.FrameTime()
                if ft and ft > 0 then
                    local current_fps = math.floor(1 / ft)
                    table.insert(_fps_samples, current_fps)
                    if #_fps_samples > _fps_MAX then
                        table.remove(_fps_samples, 1)
                    end
                end
            end)
            -- Actualizar display cada _fps_interval segundos (RealTime, no frames)
            pcall(function()
                local now = globals.RealTime()
                if now - (_G._fv2_fps_last_time or 0) >= _fps_interval then
                    _G._fv2_fps_last_time = now
                    if #_fps_samples > 0 then
                        local sum = 0
                        for _, v in ipairs(_fps_samples) do sum = sum + v end
                        _wm_cached_fps = math.floor(sum / #_fps_samples)
                    end
                end
            end)
            -- Ping: cada 1s usando RealTime (igual que FPS)
            pcall(function()
                local now = globals.RealTime()
                if now - (_G._fv2_ping_last_time or 0) >= _wm_ping_interval then
                    _G._fv2_ping_last_time = now
                    local info = client.GetPlayerInfo(client.GetLocalPlayerIndex())
                    if info and info.ping then _wm_cached_ping = info.ping end
                end
            end)
            -- Resto del cache: cada 20 frames
            _wm_frame = _wm_frame + 1
            if _wm_frame < 20 then return end
            _wm_frame = 0
