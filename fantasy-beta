    -- FIX #3: client.Command(..., true) dentro de FireGameEvent causa re-entrancia
    -- que crashea a nivel C++ (el pcall de Lua no lo atrapa).
    -- Solución: guardar el comando pendiente y ejecutarlo en fv2_draw (Draw callback).
    local function as_rage_strafer(cmd, vel)
        pcall(function()
            local spd = vel:Length2D(); if spd < 5 then return end
            local aa = tonumber(client.GetConVar("sv_airaccelerate")) or 10
            local term = 30.0 / aa / 300 * 100.0 / spd
            local delta_air = (term < 1.0 and term > -1.0) and math.acos(term) or 0.0
            local ang = engine.GetViewAngles(); ang.z = 0
            local vel_ang = math.atan2(vel.y, vel.x) - math.rad(ang.y)
            local best    = math.atan2(cmd:GetSideMove(), cmd:GetForwardMove())
            local d = vel_ang - best
            d = math.fmod(d, math.pi * 2)
            if vel_ang > best then if d >= math.pi  then d = d - math.pi*2 end
            else                   if d <= -math.pi then d = d + math.pi*2 end end
            local final = d < 0.0 and vel_ang + delta_air or vel_ang - delta_air
            cmd:SetForwardMove(math.cos(final))
            cmd:SetSideMove(math.sin(final))
        end)
    end




