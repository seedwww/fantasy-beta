    -- ----------------------------------------------------------------
    -- Draw callback principal del Legit
    -- ----------------------------------------------------------------
    local _prev = {
        aimbot    = false,
        trigger   = false,
        autofire  = false,
        autowall  = false,
        thrusmoke = false,
    }

    callbacks.Register("Draw", "fv2_kb_draw", function()
        pcall(function()

            local aimbot   = kb_trigger_aimbot:GetValue()
            local trigger  = kb_trigger:GetValue()
            local autofire = kb_autofire:GetValue()
            local autowall = kb_autowall:GetValue()

            -- ── Aimbot ──────────────────────────────────────────────
            if aimbot ~= _prev.aimbot then
                _prev.aimbot = aimbot
                if aimbot then
                    pcall(function() gui.SetValue("lbot.master",      true)  end)
                    pcall(function() gui.SetValue("lbot.enable",      true)  end)
                    pcall(function() gui.SetValue("lbot.enabled",     true)  end)
                    pcall(function() gui.SetValue("lbot.aim.enable",  true)  end)
                    pcall(function() gui.SetValue("lbot.aim.autofire",false)  end)
                else
                    pcall(function() gui.SetValue("lbot.aim.enable",  false) end)
                    pcall(function() gui.SetValue("lbot.aim.autofire",false)  end)
                    -- apagar master solo si trigger y autofire también están off
                    if not trigger and not autofire then
                        pcall(function() gui.SetValue("lbot.master",  false) end)
                        pcall(function() gui.SetValue("lbot.enable",  false) end)
                        pcall(function() gui.SetValue("lbot.enabled", false) end)
                    end
                end
            end

            -- ── Trigger ─────────────────────────────────────────────
            if trigger ~= _prev.trigger then
                _prev.trigger = trigger
                if trigger then
                    pcall(function() gui.SetValue("lbot.master",       true)  end)
                    pcall(function() gui.SetValue("lbot.enable",       true)  end)
                    pcall(function() gui.SetValue("lbot.enabled",      true)  end)
                    pcall(function() gui.SetValue("lbot.trg.enable",   true)  end)
                else
                    pcall(function() gui.SetValue("lbot.trg.enable",   false) end)
                    if not autofire then
                        pcall(function() gui.SetValue("lbot.trg.autofire", false) end)
                    end
                    if not aimbot and not autofire then
                        pcall(function() gui.SetValue("lbot.master",  false) end)
                        pcall(function() gui.SetValue("lbot.enable",  false) end)
                        pcall(function() gui.SetValue("lbot.enabled", false) end)
                    end
                end
            end

            -- ── Autofire ─────────────────────────────────────────────
            if autofire ~= _prev.autofire then
                _prev.autofire = autofire
                if autofire then
                    pcall(function() gui.SetValue("lbot.master",          true)  end)
                    pcall(function() gui.SetValue("lbot.enable",          true)  end)
                    pcall(function() gui.SetValue("lbot.enabled",         true)  end)
                    pcall(function() gui.SetValue("lbot.trg.enable",      true)  end)
                    pcall(function() gui.SetValue("lbot.trg.autofire",    true)  end)
                else
                    pcall(function() gui.SetValue("lbot.trg.autofire",    false) end)
                    if not trigger then
                        pcall(function() gui.SetValue("lbot.trg.enable",  false) end)
                    end
                    if not aimbot and not trigger then
                        pcall(function() gui.SetValue("lbot.master",  false) end)
                        pcall(function() gui.SetValue("lbot.enable",  false) end)
                        pcall(function() gui.SetValue("lbot.enabled", false) end)
                    end
                end
            end

            -- Siempre: si trigger o aimbot ON pero autofire OFF → forzar autofire false
            -- Usar sv() en vez de gui.SetValue directo para validar path y throttlear
            if (trigger or aimbot) and not autofire then
                sv("lbot.trg.autofire", false)
                sv("lbot.aim.autofire", false)
            end

            -- ── Autowall ─────────────────────────────────────────────
            if autowall ~= _prev.autowall then
                _prev.autowall = autowall
                for _, grp in ipairs(kb_wep_groups) do
                    sv("lbot.weapon.vis."..grp..".autowall", autowall)
                end
            end

            -- ── Through Smoke ─────────────────────────────────────────
            local thrusmoke = kb_thrusmoke:GetValue()
            if thrusmoke ~= _prev.thrusmoke then
                _prev.thrusmoke = thrusmoke
                for _, grp in ipairs(kb_wep_groups) do
                    sv("lbot.weapon.vis."..grp..".smoke", thrusmoke)
                end
            end

            -- ── Body Aim ─────────────────────────────────────────────
            -- FIX: hitbox se aplica UNA SOLA VEZ al activarse (no cada frame)
            -- Llamar gui.SetValue 20x/frame con autofire activo causaba crash
            if kb_forcebody:GetValue() then
                if not kb_forcebody_was_on then
                    -- 1. Guardar originales
                    for _, grp in ipairs(kb_wep_groups) do
                        pcall(function()
                            kb_forcebody_orig[grp] = {
                                aim = gui.GetValue("lbot.aim.hitbox."..grp..".hitbox"),
                                trg = gui.GetValue("lbot.trg.hitbox."..grp..".hitbox"),
                            }
                        end)
                    end
                    -- 2. Aplicar body aim solo aqui (flanco de subida)
                    for _, grp in ipairs(kb_wep_groups) do
                        pcall(function() gui.SetValue("lbot.aim.hitbox."..grp..".hitbox", "2 2 0 2 2 0 0 0") end)
                        pcall(function() gui.SetValue("lbot.trg.hitbox."..grp..".hitbox", "2 2 0 2 2 0 0 0") end)
                    end
                    kb_forcebody_was_on = true
                end
                -- Sin repeticion cada frame → no mas crash con autofire
            else
                if kb_forcebody_was_on then
                    for _, grp in ipairs(kb_wep_groups) do
                        pcall(function()
                            local orig = kb_forcebody_orig[grp]
                            if not orig then return end
                            if orig.aim ~= nil then
                                pcall(function() gui.SetValue("lbot.aim.hitbox."..grp..".hitbox", orig.aim) end)
                            end
                            if orig.trg ~= nil then
                                pcall(function() gui.SetValue("lbot.trg.hitbox."..grp..".hitbox", orig.trg) end)
                            end
                        end)
                    end
                    kb_forcebody_orig   = {}
                    kb_forcebody_was_on = false
                end
            end


            -- --------------------------------------------------------
            -- Delay Randomizer
            -- OPT: early-return antes del bloque pesado si está apagado
            -- --------------------------------------------------------
            if kb_ess_master:GetValue() then
                local _tick = globals.TickCount()   -- cachear 1 vez para todos los loops
                if kb_fovadj() then
                    local legit_active = kb_trigger:GetValue() or kb_autofire:GetValue()
                    local tick_lo = legit_active and 22 or 40
                    local tick_hi = legit_active and 50 or 90
                    for i, grp in ipairs(kb_wep_groups) do
                        pcall(function()
                            local g_mn = kb_wep_gui[i].min_fov:GetValue()
                            local g_mx = kb_wep_gui[i].max_fov:GetValue()
                            if g_mn > g_mx then g_mn, g_mx = g_mx, g_mn end
                            local st = kb_fov_state[grp]
                            if _tick >= st.next_tick then
                                local steps  = math.max(0, math.floor((g_mx - g_mn) / 0.1 + 0.5))
                                st.current   = math.floor((g_mn + math.random(0, steps) * 0.1) * 10 + 0.5) / 10
                                st.current   = math.max(g_mn, math.min(g_mx, st.current))
                                st.next_tick = _tick + math.random(tick_lo, tick_hi)
                            end
                            sv("lbot.weapon.target."..grp..".maxfov", st.current)
                            sv("lbot.weapon.vis."..grp..".maxfov",    st.current)
                        end)
                    end
                end

                if kb_trdelay() then
                    for i, grp in ipairs(kb_wep_groups) do
                        pcall(function()
                            local st = kb_delay_state[grp]
                            local mn = kb_wep_gui[i].min_delay:GetValue()
                            local mx = kb_wep_gui[i].max_delay:GetValue()
                            if mn > mx then mn, mx = mx, mn end
                            if _tick >= st.next_tick then
                                -- FIX: 8-25 ticks era demasiado rápido (~0.12-0.39s).
                                -- Ahora 50-110 ticks (~0.78-1.72s) → cambios más humanos.
                                st.current   = math.random(math.floor(mn), math.floor(mx))
                                st.next_tick = _tick + math.random(50, 110)
                            end
                            local p = "lbot.trg.weapon."..grp..".delay"
                            if gui.GetValue(p) ~= nil then gui.SetValue(p, st.current) end
                        end)
                    end
                end

                if kb_trburst() then
                    for i, grp in ipairs(kb_wep_groups) do
                        pcall(function()
                            local st = kb_burst_state[grp]
                            local mn = kb_wep_gui[i].min_burst:GetValue()
                            local mx = kb_wep_gui[i].max_burst:GetValue()
                            if mn > mx then mn, mx = mx, mn end
                            if _tick >= st.next_tick then
                                -- FIX: igual que TDelay — 50-110 ticks para variación humana
                                st.current   = math.random(math.floor(mn), math.floor(mx))
                                st.next_tick = _tick + math.random(50, 110)
                            end
                            local p = "lbot.trg.weapon."..grp..".burst"
                            if gui.GetValue(p) ~= nil then gui.SetValue(p, st.current) end
                        end)
                    end
                end

            end -- end del bloque principal de delay randomizer

        end)
    end)

    -- ----------------------------------------------------------------
    -- CreateMove: Smooth oscillation
    -- ----------------------------------------------------------------
    callbacks.Register("CreateMove", "fv2_kb_cm", function(cmd)
        if kb_ess_master:GetValue() and kb_smoothadj() then
            pcall(function()
                for i, grp in ipairs(kb_wep_groups) do
                    local st = kb_osc_state[grp]
                    local mn = kb_wep_gui[i].min_smooth:GetValue()
                    local mx = kb_wep_gui[i].max_smooth:GetValue()
                    if mn > mx then mn, mx = mx, mn end
                    -- Actualizar target cada N ticks; el valor real hace lerp gradual
                    if globals.TickCount() >= (st.next_tick or 0) then
                        local steps = math.max(0, math.floor((mx - mn) / 0.1 + 0.5))
                        st.target    = math.floor((mn + math.random(0, steps) * 0.1) * 10 + 0.5) / 10
                        st.target    = math.max(mn, math.min(mx, st.target))
                        -- FIX: 12-28 ticks era muy rápido. 30-65 ticks (~0.47-1.02s) más natural.
                        st.next_tick = globals.TickCount() + math.random(30, 65)
                    end
                    -- FIX: lerp 0.10 convergía muy rápido (robótico). 0.05 = transición más suave.
                    local tgt = st.target or st.current
                    st.current = st.current + (tgt - st.current) * 0.05
                    st.current = math.max(mn, math.min(mx, st.current))
                    local p = "lbot.weapon.aim."..grp..".smooth"
                    if gui.GetValue(p) ~= nil then gui.SetValue(p, st.current) end
                end
            end)
        end

        -- ----------------------------------------------------------------
        -- Fire Control: Stop Shot / Shot Lock / Shot Delay
        -- Un solo SetButtons al final del tick para evitar conflictos y crashes
        -- ----------------------------------------------------------------
        local _fc_any = kb_stopshot() or kb_shottiming() or kb_shotdelay()
        if _fc_any then
            pcall(function()
                if not cmd then return end
                local IN_ATTACK  = 1
                local btns = cmd:GetButtons()
                if type(btns) ~= "number" then return end
                local attacking = bit.band(btns, IN_ATTACK) ~= 0

                -- Stop Shot: detener movimiento al disparar
                if kb_stopshot() and attacking then
                    cmd:SetForwardMove(0)
                    cmd:SetSideMove(0)
                end

                local suppress = false

                -- Shot Lock: suprimir si inaccuracy > threshold
                if kb_shottiming() and attacking then
                    local ok, inacc = pcall(function()
                        local lp = entities.GetLocalPawn()
                        if not lp or not lp:IsAlive() then return 0 end
                        local wep_handle = nil
                        pcall(function()
                            local h = lp:GetPropEntity("m_hActiveWeapon")
                            if h and type(h) == "userdata" then
                                local ok2, valid = pcall(function() return h:IsValid() end)
                                if ok2 and valid then wep_handle = h end
                            end
                        end)
                        if not wep_handle then return 0 end
                        local v = 0
                        pcall(function()
                            local r = wep_handle:GetPropFloat("m_flInaccuracy")
                            if type(r) == "number" and r == r then v = r end  -- NaN guard
                        end)
                        if v == 0 then
                            pcall(function()
                                local r = wep_handle:GetPropFloat("m_fAccuracyPenalty")
                                if type(r) == "number" and r == r then v = r end
                            end)
                        end
                        return v
                    end)
                    local inacc_val = (ok and type(inacc) == "number") and inacc or 0
                    if inacc_val > kb_inacc_val:GetValue() then
                        suppress = true
                    end
                end

                -- Shot Delay: suprimir durante N ms
                -- FIX: resetear _last_shot_ms cuando no se está disparando.
                -- Sin esto, soltar y volver a presionar fire dentro del cooldown
                -- suprimía el primer disparo de la nueva ráfaga (bug de timing).
                if kb_shotdelay() then
                    if not attacking then
                        _last_shot_ms = 0
                    elseif not suppress then
                        local now_ms = globals.RealTime() * 1000
                        local sd_sel = math.max(1, math.min(#kb_sd_ms, kb_shot_wep:GetValue() + 1))
                        local delay  = (kb_sd_ms[sd_sel] and kb_sd_ms[sd_sel]:GetValue()) or 80
                        if (now_ms - _last_shot_ms) < delay then
                            suppress = true
                        else
                            _last_shot_ms = now_ms
                        end
                    end
                end

                -- Aplicar supresión una sola vez
                if suppress then
                    local new_btns = bit.band(btns, bit.bnot(IN_ATTACK))
                    if type(new_btns) == "number" then
                        cmd:SetButtons(new_btns)
                    end
                end
            end)
        end
    end)

