    callbacks.Register("Draw","fv2_tabswitch",function()
        local menu_open=false
        pcall(function() local m=gui.Reference("Menu"); if m then menu_open=m:IsActive() end end)
        if menu_open ~= _ts_last_menu then
            _ts_last_menu = menu_open
            pcall(function() win:SetActive(menu_open) end)
        end
        local t=tab_sel:GetValue()
        if t~=_last_tab then refresh_tabs();_last_tab=t end

        -- Side Colors / Crosshair Colors: solo mover si la ventana cambió de pos
        -- OPT: throttle a cada 5 frames (ventana no se mueve a 300fps)
        _ts_pos_frame = _ts_pos_frame + 1
        if _ts_pos_frame < 5 then return end
        _ts_pos_frame = 0
        pcall(function()
            local wx, wy = win:GetValue()
            if wx == _ts_last_wx and wy == _ts_last_wy then return end
            _ts_last_wx = wx; _ts_last_wy = wy
            local sep_x = wx + WIN_W + 5
            sep_win_s:SetPosX(sep_x)
            sep_win_s:SetPosY(wy)
            sep_win_x:SetPosX(sep_x)
            sep_win_x:SetPosY(wy)
        end)
