                local _paused = false
                pcall(function() _paused = engine.IsPaused() == true end)
                if _paused then return end
                -- Semi-Rage AA key handling (igual que frog: toggle por press)
                pcall(function()
                    local sr = _G._fv2_sraa
                    if sr and test4_en:GetValue() and test4_cat:GetValue() == 0 then
