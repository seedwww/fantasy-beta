local _sv_last_tick = {}
local _sv_last_val  = {}
local _sv_throttle  = 8
local function sv(path, val)
    -- Verificar que el path existe ANTES de escribir.
    -- gui.SetValue en un path inválido puede causar crash a nivel C++ que
    -- el pcall de Lua no atrapa.
    local ok_get, cur = pcall(function() return gui.GetValue(path) end)
    if not ok_get or cur == nil then return end

    local t = globals.TickCount()
    if _sv_last_val[path] ~= val then
        _sv_last_tick[path] = t
        _sv_last_val[path]  = val
        pcall(function() gui.SetValue(path, val) end)
        return
    end
    if _sv_last_tick[path] and (t - _sv_last_tick[path]) < _sv_throttle then return end
    _sv_last_tick[path] = t
    pcall(function() gui.SetValue(path, val) end)
end

