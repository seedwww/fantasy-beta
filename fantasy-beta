                              or rb_mdmg[i]:GetValue()
                    sv("rbot.hitscan.accuracy."..grp..".mindamage", v)
                    sv("rbot.accuracy."..grp..".mindamage",         v)
                    sv("rbot.weapon."..grp..".mindamage",           v)
                end
            end

        end)

            -- ── Anti-Aim ──
            pcall(function()
                local lp_pawn = entities.GetLocalPawn()
                if not lp_pawn or not lp_pawn:IsAlive() then return end

                -- Manual key tracking
                local left_key  = aa_left :GetValue()
                local right_key = aa_right:GetValue()
                local fwd_key   = aa_fwd  :GetValue()
                if (tonumber(left_key)  or 0) > 0 and input.IsButtonPressed(left_key)  then _aa_manual_state = (_aa_manual_state == 1) and 0 or 1 end
                if (tonumber(right_key) or 0) > 0 and input.IsButtonPressed(right_key) then _aa_manual_state = (_aa_manual_state == 2) and 0 or 2 end
                local fwd_active = ((tonumber(fwd_key) or 0) > 0 and input.IsButtonDown(fwd_key))
                -- FWD activo: limpiar posición left/right para ir a backwards puro
                if fwd_active then _aa_manual_state = 0 end

                local aa_on        = test4_en:GetValue() and test4_cat:GetValue() == 1
                -- FIX: AA Rage solo activo si Ragebot también está ON (previene bugs sin ragebot)
                if aa_on then aa_on = rb_rage_enable:GetValue() end
                local manual_active = (_aa_manual_state ~= 0)

                -- Detectar transicion ON→OFF: desactivar nativo una sola vez al apagar
                if _aa_was_on and not aa_on and not manual_active and not fwd_active then
                    pcall(function() gui.SetValue("rbot.antiaim.enabled", false) end)
                end
                _aa_was_on = aa_on or manual_active or fwd_active

                if not aa_on and not manual_active and not fwd_active then return end

                -- Mientras AA Rage está activo: bloquear el nativo cada frame
                if aa_on then
                    sv("rbot.antiaim.enabled", false)
                    pcall(function() gui.SetValue("rbot.antiaim.enabled", false) end)
                end

                -- FWD: forzar backwards sin tocar estado left/right
                if fwd_active then
                    sv("rbot.antiaim.yaw", 1)
                    -- pitch y directions siguen del aa_enable
                else
                    local ym     = aa_yaw:GetValue()
                    local preset = aa_yaw_preset:GetValue()
                    if manual_active then
                        sv("rbot.antiaim.yaw", 1)
